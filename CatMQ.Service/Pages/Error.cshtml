@page
@model ErrorModel
@{
    ViewData["Title"] = Localize("Error");
}

<h1 class="text-danger">@Localize("Error.")</h1>
<h2 class="text-danger">@Localize("An error occurred while processing your request.")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localize("Request ID:")</strong> <code>@Model.RequestId</code>
    </p>
}
