@using System.Reflection
@{
    var _accountId = User.Claims.Where(o => o.Type == System.Security.Claims.ClaimTypes.Sid).FirstOrDefault()?.Value;
    var _applicationVersion = string.Join('.', (Assembly.GetExecutingAssembly()
        .GetName().Version?.ToString() ?? "0.0.0.0").Split('.').Take(3)); //Major.Minor.Patch

}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CatMQ</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />

    <script src="~/lib/chartjs/chart.js" asp-append-version="true"></script>
    <script src="~/lib/confirmModal.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/site.js" asp-append-version="true"></script>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm fixed-top bg-body border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <span class="text-body"><img src="/images/32.png" /> CatMQ</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="@Localize("Toggle navigation")">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-body" href="#" id="navbarDropdownMenuLink" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">@Localize("Administration")</a>
                                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownMenuLink">
                                    <a class="nav-link" asp-page="/Accounts">@Localize("Accounts")</a>
                                    <a class="nav-link" asp-page="/Configuration">@Localize("Configuration")</a>
                                    <a class="nav-link" asp-page="/Instrumentation">@Localize("Instrumentation")</a>
                                    <a class="nav-link" asp-page="/Queues">@Localize("Queues")</a>
                                    <a class="nav-link" asp-page="/System">@Localize("System")</a>
                                </div>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-body" href="#" id="navbarDropdownMenuLink2" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">@Localize("My")</a>
                                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownMenuLink2">
                                    <a class="nav-link" href="/Account/@_accountId">@Localize("Account")</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="nav-link" asp-page="/Logout">@Localize("Logout")</a>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Login">@Localize("Login")</a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-body" href="#" id="themeToggle" data-bs-toggle="dropdown" aria-expanded="false" title="@Localize("Theme")">
                                <i id="themeToggleIcon" class="bi bi-circle-half"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="themeToggle">
                                <button type="button" class="dropdown-item" data-theme-choice="auto" onclick="setThemePreference('auto')"><i class="bi bi-circle-half me-2"></i>@Localize("Auto")</button>
                                <button type="button" class="dropdown-item" data-theme-choice="light" onclick="setThemePreference('light')"><i class="bi bi-sun-fill me-2"></i>@Localize("Light")</button>
                                <button type="button" class="dropdown-item" data-theme-choice="dark" onclick="setThemePreference('dark')"><i class="bi bi-moon-stars-fill me-2"></i>@Localize("Dark")</button>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-body" href="/Language" title="@Localize("Language")">
                                @System.Globalization.CultureInfo.CurrentUICulture.Name.ToUpperInvariant()
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container justify-content-center align-items-center" style="margin-top:80px;">
        <main role="main" class="pb-3">

            @RenderBody()

            <!-- Simple reusable Bootstrap confirm modal -->
            <div class="modal fade" id="confirmModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-body">
                            <p id="confirmModalMessage" class="mb-0"></p>
                        </div>
                        <div class="modal-footer">
                            <button id="confirmCancel" type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                @Localize("Cancel")
                            </button>
                            <button id="confirmOk" type="button" class="btn btn-danger">
                                @Localize("OK")
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <a href="https://github.com/NTDLS/CatMQ">CatMQ</a> v@(_applicationVersion) &copy; 2026 <a href="http://NetworkDLS.com/">NetworkDLS</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
