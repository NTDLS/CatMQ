@page
@model LoginModel
@{
    ViewData["Title"] = Localize("Login");
}

<div class="container d-flex justify-content-center align-items-center">
    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <p class="fw-bold">@Html.Raw(Model.ErrorMessage)</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localize("Close")"></button>
        </div>
    }

    <div class="card shadow-lg" style="width: 400px;">
        <div class="card-body">
            <h2 class="card-title text-center">@Localize("Login")</h2>
            @if (Model.ErrorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            @if (Model.IsDefaultPassword)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @Localize("The password has not yet been changed.")
                    <p>
                        <strong>@Localize("Username:")</strong> admin<br>
                        <strong>@Localize("Password:")</strong> password
                    </p>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localize("Close")"></button>
                </div>
            }
            <form method="post">
                <div class="mb-3">
                    <label for="username" class="form-label">@Localize("Username")</label>
                    <input type="text" id="username" name="Username" class="form-control" placeholder="@Localize("Enter username")" required />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">@Localize("Password")</label>
                    <input type="password" id="password" name="Password" class="form-control" placeholder="@Localize("Enter password")" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">@Localize("Login")</button>
            </form>
        </div>
    </div>
</div>
