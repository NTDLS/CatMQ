@page
@using System.Globalization
@model LanguageModel
@{
    ViewData["Title"] = Localize("Languages");
}

<style>
    .language-option {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.8rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.5rem;
        background-color: var(--bs-body-bg);
        color: var(--bs-body-color);
        text-decoration: none;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

        .language-option:hover {
            background-color: var(--bs-tertiary-bg);
            text-decoration: none;
            color: var(--bs-body-color);
        }

        .language-option.active {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
            color: #fff;
        }

    .language-native {
        font-weight: 500;
        line-height: 1;
    }

    .language-english {
        font-size: 0.9rem;
        opacity: 0.75;
        line-height: 1;
    }

    .language-code {
        font-size: 0.8rem;
        opacity: 0.6;
        line-height: 1;
        text-transform: uppercase;
    }
</style>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-1">@Localize("Languages")</h3>
        <div class="text-muted">@Localize("Choose your preferred language for the interface.")</div>
    </div>
    <div>
        <a href="@Model.ReturnUrl" class="btn btn-outline-secondary" title="@Localize("Back")">
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <span class="fw-semibold">
            <i class="bi bi-translate me-2"></i>@Localize("Available Languages")
        </span>
    </div>

    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            @foreach (var language in Model.Languages)
            {
                var isCurrent = CultureInfo.CurrentUICulture.Name == language.Name;

                <a rel="nofollow"
                   class="language-option @(isCurrent ? "active" : "")"
                   href="/Language?handler=Set&culture=@Uri.EscapeDataString(language.Name)&returnUrl=@Uri.EscapeDataString(Model.ReturnUrl)"
                   aria-current="@(isCurrent ? "true" : "false")">

                    <span class="language-native">@language.NativeName</span>
                    <span class="language-english">@Localize(language.EnglishName)</span>
                    <span class="language-code">@language.Name</span>
                </a>
            }
        </div>
    </div>
</div>
